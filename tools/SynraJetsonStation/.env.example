# Synra Jetson Station local configuration.
# Do not commit real tokens or secrets.

STATION_HOST=127.0.0.1
STATION_PORT=4788
STATION_DEVICE_ID=
STATION_DISPLAY_NAME=Workshop Jetson
STATION_APP_VERSION=0.1.0

# NodeSparkHub defaults to 8787 when Hub Server is enabled.
HUB_BASE_URL=http://127.0.0.1:8787

# Optional paired Hub token. Keep this server-side only.
HUB_DEVICE_TOKEN=

# Capabilities are disabled until a real camera/mic path is wired and visible.
STATION_CAMERA_ENABLED=false
STATION_MICROPHONE_ENABLED=false
STATION_LOCAL_VISION=false
STATION_LOCAL_SPEECH=false

# Kiosk launcher can use this if chromium-browser/chromium is not in PATH.
CHROMIUM_BIN=

# Dedicated Electron kiosk shell. This avoids snap Chromium confinement.
SYNRA_STANDALONE_URL=http://127.0.0.1:5191/
SYNRA_KIOSK_REMOTE_DEBUG=true
SYNRA_KIOSK_DEBUG_PORT=9222
SYNRA_KIOSK_ANGLE_BACKEND=vulkan
SYNRA_KIOSK_GL_MODE=none
SYNRA_KIOSK_OZONE_PLATFORM=
SYNRA_KIOSK_FPS=30
SYNRA_KIOSK_QUALITY=sharp
SYNRA_KIOSK_RENDER_SCALE=1
SYNRA_KIOSK_MAX_RENDER_WIDTH=2560
SYNRA_KIOSK_MAX_RENDER_HEIGHT=1600
SYNRA_KIOSK_AVATAR=code1
SYNRA_KIOSK_AUTO_GRANT_MEDIA=false
